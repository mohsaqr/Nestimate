expression(utils::globalVariables(c("u", "y", "ymin", "ymax", 
    "label", "state", "group", "value", "depth", "h", "label_y")), 
    .ls_bad <- function(msg, class = "nestimate_bad_input") {
        stop(errorCondition(msg, class = class, call = NULL))
    }, .ls_counts <- function(states, alphabet, sequence_weights = NULL) {
        k <- length(alphabet)
        codes <- matrix(match(states, alphabet) - 1L, nrow = nrow(states))
        if (ncol(codes) < 2L) 
            return(matrix(0L, nrow(codes), k * k))
        cell <- codes[, -ncol(codes), drop = FALSE] * k + codes[, 
            -1L, drop = FALSE] + 1L
        counts <- t(apply(cell, 1L, function(v) tabulate(v[!is.na(v)], 
            nbins = k * k)))
        if (is.null(sequence_weights)) 
            counts
        else counts * sequence_weights
