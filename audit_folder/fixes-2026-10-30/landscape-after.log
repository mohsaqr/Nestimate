        states, measure, k, n_grid, name, sequence_weights = NULL) {
        met <- sequence_metrics(states_mat)
        keep <- which(met$valid_n >= 2L & !is.na(met[[measure]]))
        if (length(keep) < 5L) {
            .ls_bad(sprintf("'%s': fewer than 5 sequences with two or more observed states.", 
                name), class = "nestimate_landscape_unestimable")
        }
        m <- met[[measure]][keep]
        counts <- .ls_counts(states_mat[keep, , drop = FALSE], 
