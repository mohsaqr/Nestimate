# How Nestimate is tested on the Mac mini (ci VM). Run in the repo: mini-ci [job]
#   job NAME COMMAND (first = default) · env KEY=VALUE · sibling ../DIR · include PATH
#   fetch PATH · node mac|X.Y.Z|system (mac = the same Node version as this Mac)
node system

# R package: dependencies (incl. Suggests) come from DESCRIPTION. A local package this one
# needs unreleased goes in as: sibling ../DIR
# A warning a test does not expect fails the job, like a failure.
job test   Rscript -e 'r <- as.data.frame(testthat::test_local(stop_on_failure = TRUE)); w <- sum(r$warning); if (w > 0) { message(w, " unexpected warning(s); expect them or fix their cause."); quit(status = 1) }'
job check  Rscript -e 'r <- rcmdcheck::rcmdcheck(args = c("--no-manual", "--as-cran"), error_on = "never"); print(r); if (r$status != 0 || length(r$errors) || length(r$warnings)) quit(status = 1)'
job release-test Rscript scripts/cran-release-check.R test
job release-check Rscript scripts/cran-release-check.R check
job release-revdeps Rscript scripts/cran-release-check.R revdeps
fetch .ci/cran-review

# the local cograph, not the released one
sibling ../cograph

# Prova Verify: capture of the equivalence tests, run as
#   mini-ci -- Rscript ../equivalence/nestimate/import-tests.R capture [file-regex]
include ../equivalence/nestimate/local
include ../equivalence/nestimate/import-tests.R
include ../equivalence/import-tests-common.R
include ../prova/.claude/worktrees/verify/reporters/verify-capture.R
fetch .ci/verify-capture

# The declared equivalence tests (tests/equivalence, the standard: ../equivalence/STANDARD.md): every
# comparison with a reference, recorded in .ci/verify-capture/capture.json. Reference packages outside
# Suggests come from ~/equiv-lib, Python ones from ~/equiv-py. Then, on the Mac:
#   sh ../equivalence/push.sh nestimate
job verify RETICULATE_PYTHON=$HOME/equiv-py/bin/python Rscript -e 'source("tests/equivalence/helper-verify.R"); verify_tests(lib = "~/equiv-lib")'
